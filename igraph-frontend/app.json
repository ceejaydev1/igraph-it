{
  "expo": {
    "name": "iGraph IT",
    "slug": "igraph-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#eef0fb"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dcttarlac.igraphit"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#eef0fb"
      },
      "package": "com.dcttarlac.igraphit"
    },
    "web": {
      "favicon": "./assets/images/logo.png",
      "name": "iGraph IT",
      "shortName": "iGraph IT",
      "description": "Learn and create SDLC and UML diagrams",
      "themeColor": "#3b5bdb",
      "backgroundColor": "#eef0fb",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/",
      "lang": "en",
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "scheme": "igraphit",
    "experiments": {
      "typedRoutes": true
    }
  }
}